{
  "tesserae_compat": "1.x",
  "name": "Home Assistant, China Southern Grid",
  "version": "0.2.0",
  "kind": "widget",
  "description": "Daily electricity usage and current-month kWh with the previous issued monthly bill from Home Assistant. No estimated costs or unavailable tariff data.",
  "icon": "ph-lightning",
  "supports": {
    "sizes": [
      "xs",
      "sm",
      "md",
      "lg"
    ]
  },
  "settings": [],
  "cell_options": [
    {
      "name": "account",
      "type": "select",
      "label": "Electricity account",
      "default": "",
      "choices_from": "account",
      "help": "Auto-discovers China Southern Power Grid accounts from Home Assistant. Account numbers are masked in rendered output."
    },
    {
      "name": "account_label",
      "type": "string",
      "label": "Account label (optional)",
      "default": ""
    },
    {
      "name": "label",
      "type": "string",
      "label": "Module label",
      "default": "ENERGY//USAGE"
    },
    {
      "name": "window",
      "type": "select",
      "label": "Trend window",
      "default": "14",
      "choices": [
        {
          "value": "7",
          "label": "Last 7 days"
        },
        {
          "value": "14",
          "label": "Last 14 days"
        },
        {
          "value": "30",
          "label": "Last 30 days"
        },
        {
          "value": "month",
          "label": "Current month"
        }
      ]
    },
    {
      "name": "threshold_mode",
      "type": "select",
      "label": "Colour thresholds",
      "default": "auto",
      "choices": [
        {
          "value": "auto",
          "label": "Automatic from visible data"
        },
        {
          "value": "manual",
          "label": "Manual daily usage thresholds"
        }
      ]
    },
    {
      "name": "show_comparison",
      "type": "boolean",
      "label": "Compare daily average with the previous full month",
      "default": true
    },
    {
      "name": "layout",
      "type": "select",
      "label": "Module layout",
      "default": "standard",
      "choices": [
        {
          "value": "standard",
          "label": "Standard split module"
        },
        {
          "value": "overview",
          "label": "Room overview"
        }
      ]
    },
    {
      "name": "low_kwh_threshold",
      "type": "number",
      "label": "Low-to-medium usage (kWh)",
      "default": 15
    },
    {
      "name": "high_kwh_threshold",
      "type": "number",
      "label": "Medium-to-high usage (kWh)",
      "default": 25
    }
  ],
  "render": {
    "dither": "floyd-steinberg",
    "needs_network": false
  },
  "fragments": [
    {
      "id": "full",
      "label": "Usage and previous monthly bill",
      "w": 1120,
      "h": 440,
      "icon": "ph-lightning"
    },
    {
      "id": "summary",
      "label": "Usage and bill summary",
      "w": 380,
      "h": 320,
      "icon": "ph-lightning"
    },
    {
      "id": "trend",
      "label": "Daily electricity usage",
      "w": 780,
      "h": 320,
      "icon": "ph-chart-line-up"
    },
    {
      "id": "billing",
      "label": "Previous monthly bill",
      "w": 500,
      "h": 160,
      "icon": "ph-currency-cny"
    }
  ],
